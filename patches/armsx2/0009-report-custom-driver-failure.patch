@@ -923,6 +923,18 @@
     // with an emulator that refuses to boot.
     Vulkan::SetCustomDriverPath(
         dir.c_str(), name.c_str(), redir.c_str(), hook.c_str(), /*required=*/false);
+}
+
+extern "C"
+JNIEXPORT jstring JNICALL
+Java_kr_co_iefriends_pcsx2_NativeApp_getCustomVulkanDriverFailure(JNIEnv* env, jclass) {
+    // Empty when no custom driver was asked for or it opened. Otherwise why it did not: the Vulkan
+    // library falls back to the system loader without saying so.
+    const Vulkan::CustomDriverStatus status = Vulkan::GetCustomDriverStatus();
+    std::string failure;
+    if (status.requested && !status.opened)
+        failure = status.failure.empty() ? std::string("unknown reason") : status.failure;
+    return env->NewStringUTF(failure.c_str());
 }
 
 extern "C"
