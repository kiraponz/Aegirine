--- a/platforms/android/app/src/main/cpp/native-lib.cpp
+++ b/platforms/android/app/src/main/cpp/native-lib.cpp
@@ -937,6 +937,20 @@
     // Frames emulated so far, which counts game time whatever the speed. Read without a lock: a
     // slightly stale value is fine for the macro clock.
     return static_cast<jlong>(g_FrameCount);
+}
+
+extern "C"
+JNIEXPORT jboolean JNICALL
+Java_kr_co_iefriends_pcsx2_NativeApp_readEeMemory(JNIEnv* env, jclass, jint address, jbyteArray out) {
+    // Copies main RAM (the first 32 MB of the EE address space) into [out], for the app's memory
+    // search. Refuses a range outside it. The caller pauses the game first for a steady picture.
+    if (!VMManager::HasValidVM() || !eeMem || address < 0 || out == nullptr)
+        return JNI_FALSE;
+    const jsize length = env->GetArrayLength(out);
+    if (static_cast<uint64_t>(address) + static_cast<uint64_t>(length) > Ps2MemSize::MainRam)
+        return JNI_FALSE;
+    env->SetByteArrayRegion(out, 0, length, reinterpret_cast<const jbyte*>(eeMem->Main + address));
+    return JNI_TRUE;
 }
 
 extern "C"
