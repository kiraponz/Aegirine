+
+extern "C"
+JNIEXPORT jboolean JNICALL
+Java_kr_co_iefriends_pcsx2_NativeApp_writeEeMemory(JNIEnv* env, jclass, jint address, jbyteArray data) {
+    // Writes [data] into main RAM at [address] (the app's memory editor), same range as readEeMemory.
+    // Compiled blocks over the written words are dropped so code patched this way is picked up.
+    if (!VMManager::HasValidVM() || !eeMem || address < 0 || data == nullptr)
+        return JNI_FALSE;
+    const jsize length = env->GetArrayLength(data);
+    if (static_cast<uint64_t>(address) + static_cast<uint64_t>(length) > Ps2MemSize::MainRam)
+        return JNI_FALSE;
+    env->GetByteArrayRegion(data, 0, length, reinterpret_cast<jbyte*>(eeMem->Main + address));
+    if (Cpu)
+        Cpu->Clear(static_cast<u32>(address) & ~3u, (static_cast<u32>(length) + 7) / 4);
     return JNI_TRUE;
 }
 
