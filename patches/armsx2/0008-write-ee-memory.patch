     if (static_cast<uint64_t>(address) + static_cast<uint64_t>(length) > Ps2MemSize::MainRam)
         return JNI_FALSE;
     env->SetByteArrayRegion(out, 0, length, reinterpret_cast<const jbyte*>(eeMem->Main + address));
